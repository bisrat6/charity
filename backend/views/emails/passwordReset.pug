//- Password reset email template for CORNERSTONE
doctype html
html
  head
    meta(charset="UTF-8")
    title Password Reset Request | CORNERSTONE
    style.
      body { font-family: 'Segoe UI', Arial, sans-serif; background: #f7f8fa; color: #222; margin: 0; padding: 0; }
      .container { max-width: 520px; margin: 40px auto; background: #fff; border-radius: 10px; box-shadow: 0 2px 8px #e0e0e0; padding: 32px 28px; }
      .brand { color: #1a73e8; font-weight: 700; font-size: 2rem; letter-spacing: 1px; }
      .btn { display: inline-block; background: #1a73e8; color: #fff; padding: 12px 32px; border-radius: 6px; text-decoration: none; font-weight: 600; margin-top: 24px; }
      .footer { color: #888; font-size: 0.95rem; margin-top: 32px; text-align: center; }
  body
    .container
      .brand CORNERSTONE
      h2(style="margin-top: 24px;") Password Reset Request
      p Dear #{name},
      p You requested a password reset for your CORNERSTONE account. Click the button below to reset your password:
      p
        a.btn(href=resetUrl) Reset Password
      p Or copy and paste this link into your browser:
      p(style="word-break: break-all; color: #666;") #{resetUrl}
      p This link will expire in 1 hour.
      p If you didn't request a password reset, please ignore this email. Your password will remain unchanged.
      p(style="margin-top: 32px;")
        | Best regards,
        br
        | The CORNERSTONE Team
      .footer
        | &copy; #{year} CORNERSTONE. All rights reserved.
